# ============================================================================
# 复制为 .env(本地)或配置为 GitHub Actions Secrets / Vars(线上)
# ============================================================================

# ---- Supabase(数据库 + Auth + 自动 API)----
# 前端用(公开,构建时注入,anon key 受 RLS 保护)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# 管道用(仅 Actions,绝不进前端;可绕过 RLS 批量写库)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# 仅本地跑迁移用(pnpm db:migrate),二选一:
# A. 直连 Postgres:Settings → Database → Connection string → Session pooler(需数据库密码)
# SUPABASE_DB_URL=postgresql://postgres.YOUR-REF:YOUR-DB-PASSWORD@aws-0-xxx.pooler.supabase.com:5432/postgres
# B. Management API 令牌:https://supabase.com/dashboard/account/tokens(无需数据库密码)
# SUPABASE_ACCESS_TOKEN=sbp_YOUR-ACCESS-TOKEN

# ---- 阿里百炼 / DashScope(OpenAI 兼容)----
# 在 https://bailian.console.aliyun.com 获取 API Key,自行填入
DASHSCOPE_API_KEY=YOUR-DASHSCOPE-API-KEY
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# tier-1 粗分类模型(便宜);tier-2 深评可用 qwen-max
DASHSCOPE_MODEL=qwen-plus
DASHSCOPE_MODEL_DEEP=qwen-max

# ---- GitHub(抓取用,PAT 提升配额)----
# 细粒度或经典 PAT,建议 public_repo / read-only 足够
GITHUB_TOKEN=YOUR-GITHUB-PAT

# ---- 前端部署基路径(GitHub Pages 项目站点子路径)----
# 例:仓库名为 github-analytics → /github-analytics;自定义域名或用户站点留空
NEXT_PUBLIC_BASE_PATH=

# ---- 管理台鸿蒙审核授权(只允许该邮箱登录后写 overrides)----
NEXT_PUBLIC_ADMIN_EMAIL=you@example.com
